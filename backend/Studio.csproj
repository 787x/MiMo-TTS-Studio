<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>MiMoStudio</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NLayer" Version="3.0.0" /></ItemGroup>
  <ItemGroup>
    <!-- Runtime state and local UI previews must never enter a publish payload.
         The FPK build copies the verified frontend dist explicitly. -->
    <Content Remove=".dev/**;wwwroot/**" />
    <None Remove=".dev/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\agent-shared\Agent.Shared.csproj" />
  </ItemGroup>
</Project>
