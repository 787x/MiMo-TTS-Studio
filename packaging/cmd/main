#!/bin/bash
set -eu
umask 077
: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}" "${TRIM_PKGTMP:?}"
binary="${TRIM_APPDEST}/server/MiMoStudio"
pidfile="${TRIM_PKGVAR}/server.pid"
socket="${TRIM_APPDEST}/app.sock"
mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC" "$TRIM_PKGTMP/mimotts-work"
chmod 700 "$TRIM_PKGETC" "$TRIM_PKGVAR" "$TRIM_PKGTMP/mimotts-work"
exec 9>"${TRIM_PKGVAR}/lifecycle.lock"
flock -x 9
alive() {
    [ -f "$pidfile" ] || return 1
    read -r app_pid app_start < "$pidfile" || return 1
    [[ "$app_pid" =~ ^[0-9]+$ ]] || return 1
    # fnOS restricts /proc/PID/exe even for the package user's own process.
    # cmdline + kernel start ticks avoid PID reuse without requiring ptrace access.
    local process_command
    IFS= read -r -d '' process_command < "/proc/$app_pid/cmdline" 2>/dev/null || return 1
    [ "$process_command" = "$binary" ] || return 1
    [ "$(awk '{print $22}' "/proc/$app_pid/stat" 2>/dev/null)" = "$app_start" ] || return 1
    [ "$(awk '{print $3}' "/proc/$app_pid/stat" 2>/dev/null)" != Z ] || return 1
    kill -0 "$app_pid" 2>/dev/null
}
case "${1:-}" in
start)
    if alive; then exit 0; fi
    cd "${TRIM_APPDEST}/server"
    # Bounded, rotated operational log; the service never logs HTTP data or secrets.
    if [ -f "${TRIM_PKGVAR}/service.log" ] && [ "$(stat -c %s "${TRIM_PKGVAR}/service.log")" -gt 1048576 ]; then
        mv -f "${TRIM_PKGVAR}/service.log" "${TRIM_PKGVAR}/service.log.old"
    fi
    export DOTNET_EnableDiagnostics=0 DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
    unset ASPNETCORE_URLS ASPNETCORE_ENVIRONMENT DOTNET_ENVIRONMENT MIMO_DEV_LOCAL
    "$binary" >>"${TRIM_PKGVAR}/service.log" 2>&1 9>&- &
    app_pid=$!
    app_start=$(awk '{print $22}' "/proc/$app_pid/stat")
    printf '%s %s\n' "$app_pid" "$app_start" > "$pidfile"
    for i in $(seq 1 100); do
        if ! alive; then
            echo 'MiMo Studio 启动失败，请查看应用私有 service.log。' > "${TRIM_TEMP_LOGFILE:-/dev/null}"
            rm -f "$pidfile"
            exit 1
        fi
        [ -S "$socket" ] && [ "$(stat -c %a "$socket")" = 600 ] && exit 0
        sleep 0.1
    done
    kill -TERM "$app_pid" 2>/dev/null || true
    exit 1
    ;;
stop)
    if alive; then
        kill -TERM "$app_pid"
        for i in $(seq 1 100); do alive || break; sleep 0.1; done
        if alive; then kill -KILL "$app_pid"; fi
    fi
    rm -f "$pidfile" "$socket" "${TRIM_APPDEST}/agent.sock"
    # Only this app's designated temporary file names.
    find "${TRIM_PKGTMP}/mimotts-work" -maxdepth 1 -type f -name '*.partial' -delete
    ;;
status)
    if alive && [ -S "$socket" ]; then exit 0; else exit 3; fi
    ;;
*) exit 1 ;;
esac
